#!/usr/bin/bash

set -u

INTEGRATION_VERSION="1"
STATE_ROOT="${XDG_STATE_HOME:-${HOME}/.local/state}/meyuroos"
MARKER="${STATE_ROOT}/task-manager-integration-version"
UPDATE_SCRIPT="/usr/share/meyuroos/shell-updates/meyuro-task-manager-context-menu.js"

if [[ -r "${MARKER}" ]] && [[ "$(<"${MARKER}")" == "${INTEGRATION_VERSION}" ]]; then
    exit 0
fi

if ! command -v qdbus6 >/dev/null 2>&1 || [[ ! -r "${UPDATE_SCRIPT}" ]]; then
    exit 0
fi

if ! qdbus6 org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript "$(<"${UPDATE_SCRIPT}")" >/dev/null 2>&1; then
    exit 0
fi

mkdir -p "${STATE_ROOT}"
printf '%s\n' "${INTEGRATION_VERSION}" >"${MARKER}"
