[%General]
author=MeyuroOS
comment=Translucent blue glass application style for MeyuroOS
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=false
embedded_tabs=true
joined_inactive_tabs=true
group_toolbar_buttons=true
spread_progressbar=true
composite=true
menu_shadow_depth=8
menu_blur_radius=6
tooltip_shadow_depth=7
tooltip_blur_radius=6
scroll_width=12
scroll_arrows=false
scroll_min_extent=50
transient_scrollbar=true
transient_groove=true
slider_width=6
slider_handle_width=18
slider_handle_length=18
check_size=18
progressbar_thickness=7
menubar_mouse_tracking=true
toolbutton_style=0
click_behavior=0
translucent_windows=true
blurring=true
popup_blurring=true
reduce_window_opacity=6
reduce_menu_opacity=5
contrast=0.92
intensity=1.12
saturation=1.18
opaque=kaffeine,kdenlive,vlc,smplayer,VirtualBox,VirtualBoxVM,steam,steamwebhelper,gamescope,mpv
vertical_spin_indicators=false
fill_rubberband=false
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
button_icon_size=16
toolbar_interior_spacing=4
toolbar_icon_size=16
combo_as_lineedit=true
combo_menu=true
combo_focus_rect=true
groupbox_top_label=true
inline_spin_indicators=true
remove_extra_frames=true
layout_spacing=5
submenu_overlap=0
tooltip_delay=-1
animate_states=true
hide_combo_checkboxes=false
no_window_pattern=false
respect_DE=false
scrollbar_in_view=true
spin_button_width=18
submenu_delay=220
tree_branch_line=false
no_inactiveness=false

[GeneralColors]
window.color=#122D5ED8
inactive.window.color=#172B51D0
base.color=#123066C8
inactive.base.color=#172C55C2
alt.base.color=#1B3B78B8
inactive.alt.base.color=#1A315FB8
button.color=#355F9EBC
inactive.button.color=#2D4B7DAE
light.color=#B8D3FF80
mid.light.color=#7FA8E86E
dark.color=#081936A8
mid.color=#234C89A0
highlight.color=#0A78C8FF
inactive.highlight.color=#276BA6D8
tooltip.base.color=#17376BEA
text.color=#F2F7FFFF
inactive.text.color=#B8CAE8FF
window.text.color=#F2F7FFFF
inactive.window.text.color=#B8CAE8FF
button.text.color=#F4F8FFFF
inactive.button.text.color=#BCCDE8FF
disabled.text.color=#7891BAFF
tooltip.text.color=#F7FAFFFF
highlight.text.color=#FFFFFFFF
inactive.highlight.text.color=#E7F1FFFF
link.color=#57CAFFFF
link.visited.color=#CB91FFFF
negative.text.color=#FF6F91FF
neutral.text.color=#FFBE52FF
positive.text.color=#53E0A4FF
progress.indicator.text.color=#FFFFFFFF

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
transparent_pcmanfm_view=true
blur_translucent=true
transparent_menutitle=true
respect_darkness=true
force_size_grip=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=72
normal_default_pushbutton=false
single_top_toolbar=false
tint_on_mouseover=0
middle_click_scroll=false
no_selection_tint=true
transparent_arrow_button=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior=true
interior.element=button
indicator.size=11
text.normal.color=#F4F8FF
text.focus.color=#FFFFFF
text.press.color=#FFFFFF
text.toggle.color=#FFFFFF
text.normal.inactive.color=#B8CAE8
text.toggle.inactive.color=#C7D8F2
text.shadow=true
text.shadow.color=#061128
text.shadow.xshift=0
text.shadow.yshift=1
text.shadow.depth=1
text.shadow.alpha=90
text.margin=1
text.iconspacing=5
indicator.element=arrow
text.margin.top=3
text.margin.bottom=3
text.margin.left=6
text.margin.right=6
frame.expansion=12
min_width=+6

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolbarButton]
inherits=PanelButtonCommand
frame.element=tbutton
interior.element=tbutton
indicator.element=tarrow

[ToolbarLineEdit]
frame.element=tlineedit
interior.element=tlineedit
indicator.element=carrow

[Dock]
inherits=PanelButtonCommand
interior.element=dock
frame.element=dock
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
indicator.element=dock

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#F4F8FF
text.focus.color=#FFFFFF
text.normal.inactive.color=#B8CAE8
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=11

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio
text.focus.color=#7DD9FF

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox
text.focus.color=#7DD9FF

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
interior.element=common
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3

[LineEdit]
inherits=PanelButtonCommand
frame.element=le
interior.element=le
frame.expandedElement=lineedit
interior.expandedElement=lineedit
text.margin.left=5
text.margin.right=5
text.margin.top=3
text.margin.bottom=3
indicator.element=larrow

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=11

[ToolboxTab]
inherits=PanelButtonCommand
text.focus.color=#7DD9FF
text.boldness=2

[Tab]
inherits=PanelButtonCommand
interior.element=button
frame.element=button
focusFrame=true
indicator.element=tab
indicator.size=14
text.margin.left=7
text.margin.right=7
text.margin.top=3
text.margin.bottom=3
text.boldness=2
min_width=+0.2font

[TabFrame]
inherits=PanelButtonCommand
frame=true
frame.element=tframe
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
interior=true
interior.element=tframe

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=12
indicator.element=arrow

[HeaderSection]
inherits=PanelButtonCommand
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=2
text.margin.bottom=2
text.margin.left=3
text.margin.right=3

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=5
text.margin=0
interior.element=menubar
frame.element=menubar
frame.top=0
frame.bottom=3
frame.expansion=0

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
focusFrame=true

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior.element=progress
text.margin=0
text.bold=true

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
frame.top=3
frame.bottom=3
frame.left=3
frame.right=3
interior.element=progress-pattern

[ItemView]
inherits=PanelButtonCommand
text.margin=true
frame.element=itemview
interior.element=itemview
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.top=1
text.margin.bottom=1
text.margin.left=3
text.margin.right=3
frame.expansion=0

[Splitter]
indicator.size=32

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=11

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.left=6
frame.right=6
frame.top=6
frame.bottom=6
indicator.element=grip
indicator.size=13
frame.expansion=0

[ScrollbarGroove]
inherits=PanelButtonCommand
interior=false
frame=false

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.margin.top=2
text.margin.bottom=2
text.margin.left=5
text.margin.right=5
frame.top=3
frame.bottom=3
frame.left=6
frame.right=6
frame.expansion=0

[MenuBar]
inherits=PanelButtonCommand
frame.element=menubar
interior.element=menubar
frame.expansion=0

[MenuBarItem]
inherits=PanelButtonCommand
interior=true
frame=false
interior.element=menubaritem
frame.element=menubaritem
frame.top=3
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=5
text.margin.right=5
text.margin.top=3
text.margin.bottom=3
frame.expansion=0

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
indicator.element=mdi
text.bold=true
frame.expansion=0

[ComboBox]
inherits=PanelButtonCommand
indicator.element=carrow

[Menu]
inherits=PanelButtonCommand
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
frame.element=menu
interior.element=menu
frame.expansion=0

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
text.shadow=0
text.margin=0
frame.top=4
frame.bottom=4
frame.left=4
frame.right=4
text.focus.color=#7DD9FF
text.bold=true
text.boldness=2
frame.expansion=0

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false
text.shadow=0

[ToolTip]
inherits=GenericFrame
frame.top=6
frame.bottom=6
frame.left=6
frame.right=6
interior=true
text.shadow=0
text.margin=0
interior.element=tooltip
frame.element=tooltip
frame.expansion=0

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=true
interior.element=window

[WindowTranslucent]
interior=true
interior.element=window

[Dialog]
interior=true
interior.element=dialog

[DialogTranslucent]
interior=true
interior.element=dialog
